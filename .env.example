# WEB container variables
SKELETON_VARIANT=pim-no-demo
PRODUCTION_DOMAIN=localhost
PRODUCTION_STABILITY=stable
TESTING_DOMAIN=
TESTING_STABILITY=rc

# base or pdf
BUILD_VARIANT=base


# Postgres container variables
POSTGRES_PASSWORD=
POSTGRES_PIM_USER=
POSTGRES_PIM_PASSWORD=
POSTGRES_PIM_DB=atrocore
POSTGRES_PIM_DB_TEST=

# Proxy configuration
LETS_ENCRYPT_EMAIL=
PROXY_PRODUCTION_ROUTER=atrocore_prod
PROXY_TESTING_ROUTER=

# ---------------------------------------------------------------------------
# BIND_IP — which host interface published ports listen on.
#
# Default 0.0.0.0 (all interfaces) keeps the demo and CI working: the
# quickstart and demo-verify-ci.sh reach services over the network, and under
# dind DEMO_HOST is `docker`, not localhost, so a hardcoded loopback bind
# would break the whole-stack guard.
#
# A production deployment sets BIND_IP=127.0.0.1 so every service is reachable
# only from the host itself, and the single TLS edge (compliance_web's
# frontend-tls, host 443) is the only externally published port. See
# "An ideal production configuration.md" section 2.3.
BIND_IP=0.0.0.0

# --- Offsite backup encryption (P3.4) ---------------------------------------
# One or more age PUBLIC keys, separated by whitespace. When set, everything
# backup-offsite.sh sends to a destination is encrypted to them, and the
# destination holds ciphertext only. ANY ONE of the matching private keys
# opens a set, at about 100 bytes of overhead per recipient.
#
# TWO KEYS IN DIFFERENT CUSTODY IS THE SHAPE WORTH CONFIGURING. Escrow's real
# question is not "is the key safe" but "is there a second way to get it at
# 3am". An operations key in the organisation's vault, used for routine
# restores and drills, plus a break-glass key on sealed paper or split across
# officers, touched only under a signed procedure:
#
#     BACKUP_AGE_RECIPIENT="age1<operations> age1<break-glass>"
#
# Either opens any set; either can be rotated without re-encrypting for the
# other. ROTATION HAS A TAIL: a set stays encrypted to the keys it was made
# with, so escrow must keep every key still covering a set inside the
# retention window (BACKUP_RETENTION_DAYS, 30 by default) or the sets in
# between become unreadable.
#
# This host holds the public key and nothing else, so it can make backups and
# cannot read any of them -- including its own history. Generate a keypair
# somewhere OTHER than this machine:
#
#     age-keygen -o escrow.key        # keep this file in escrow, off-host
#     age-keygen -y escrow.key        # the public key -> BACKUP_AGE_RECIPIENT
#
# Local sets stay in plaintext on purpose: decryption needs the escrowed key,
# and the ordinary same-host restore is measured at 1m40s and should not wait
# on an escrow retrieval. What this protects is the copy held by someone else.
#
# preflight-secrets.sh --production fails if a destination is configured
# without this, and fails again if the private key is found on this host.
BACKUP_AGE_RECIPIENT=

# The escrowed PRIVATE key, needed only to pull and decrypt an offsite set.
# Leave this unset in normal operation: `push` refuses to run while it is
# present, because a host that can decrypt its own backups is not protected
# by encrypting them.
# BACKUP_AGE_IDENTITY_FILE=/path/to/escrow.key
