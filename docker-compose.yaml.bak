services:
  atro-web:
    build:
      context: .docker
      dockerfile: php/Dockerfile
      args:
        SKELETON_VARIANT: ${SKELETON_VARIANT:-pim-no-demo}
        PRODUCTION_DOMAIN: ${PRODUCTION_DOMAIN:-localhost}
        PRODUCTION_DB: ${POSTGRES_PIM_DB}
        PRODUCTION_STABILITY: ${PRODUCTION_STABILITY:-stable}
        TESTING_DOMAIN: ${TESTING_DOMAIN}
        TESTING_STABILITY: ${TESTING_STABILITY:-stable}
        TESTING_DB: ${POSTGRES_PIM_DB_TEST}
        DB_USER: ${POSTGRES_PIM_USER}
        DB_PASSWORD: ${POSTGRES_PIM_PASSWORD}
    ports:
      - 80:80
    volumes:
      - ./web-data:/var/www/
    restart: unless-stopped
    networks:
      - atrocore_net
      - backend_ext_net

  db:
    image: postgres:15-alpine
    environment:
      PGDATA: /var/lib/postgresql/data/pgdata
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_PIM_USER: ${POSTGRES_PIM_USER}
      POSTGRES_PIM_PASSWORD: ${POSTGRES_PIM_PASSWORD}
      POSTGRES_PIM_DB: ${POSTGRES_PIM_DB}
      POSTGRES_PIM_DB_TEST: ${POSTGRES_PIM_DB_TEST}
    volumes:
      - .docker/postgres/scripts:/docker-entrypoint-initdb.d
      - ./db-data:/var/lib/postgresql/data/
    restart: unless-stopped
    networks:
      - atrocore_net

volumes:
  web-data:
  db-data:

networks:
  atrocore_net:
    driver: bridge
  backend_ext_net:
    name: backend_net

