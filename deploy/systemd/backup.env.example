# Backup configuration for the systemd units.
#
#   install -d -m 0750 /etc/compliance-platform
#   cp deploy/systemd/backup.env.example /etc/compliance-platform/backup.env
#   chmod 0600 /etc/compliance-platform/backup.env
#
# NOT in the repository, and 0600, because this holds destination
# credentials. The units reference it as an EnvironmentFile so the unit
# files themselves stay free of secrets and can be reviewed in git.

# Where local sets are written. A volume SEPARATE from the platform data.
BACKUP_DIR=/srv/backups/compliance-platform
BACKUP_RETENTION_DAYS=30

# --- offsite destination --------------------------------------------------
# One of the drivers in backup-destinations/. See its README for the
# configuration each one takes.
BACKUP_DESTINATION=rsync-ssh
BACKUP_DEST_SSH=backup@dr.authority.example
BACKUP_DEST_PATH=/srv/oversight-backups/sets
BACKUP_SSH_KEY=/etc/compliance-platform/backup-id_ed25519

# WAL wants its own path or prefix: it is small and frequent where sets are
# large and rare, and they usually want different retention. Point the WAL
# unit at a sibling location by overriding the driver's path here is NOT
# possible -- one EnvironmentFile serves both units, so give WAL its own
# file if the destinations must differ:
#
#   EnvironmentFile=/etc/compliance-platform/backup-wal.env
#
# in compliance-wal-ship.service.

# How many segments one shipper run may move. At 16MB each, a large backlog
# is many gigabytes of staging.
WAL_SHIP_BATCH_MAX=512

# --- observability --------------------------------------------------------
# node-exporter's textfile collector directory. The units record when each
# job last ran and last SUCCEEDED here, and Prometheus alerts when a success
# gets stale or the metric is missing entirely -- which is what a timer that
# was never enabled looks like.
BACKUP_METRICS_DIR=/var/lib/node_exporter/textfile
