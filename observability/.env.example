# observability/.env.example — copy to observability/.env before starting the stack.
#
#   cp observability/.env.example observability/.env
#   docker compose -f observability/docker-compose.yaml up -d
#
# This is a SEPARATE .env from atrocore-docker's own, because this is a
# separate compose project. Compose reads the .env beside the compose file it
# was given, so the values below do not reach the application stack and the
# application stack's values do not reach here.

# Where the monitoring UIs listen. Default 127.0.0.1: Prometheus has no
# authentication of any kind and Alertmanager can silence alerts, so neither
# should ever be published to a network. Reach them over an SSH tunnel:
#
#   ssh -L 3001:127.0.0.1:3001 -L 9090:127.0.0.1:9090 <host>
#
# Grafana is the only one with a login, and it is still bound to loopback here
# on the same reasoning: if it needs to be reachable, put it behind the TLS
# edge P3.3 built rather than publishing it directly.
OBS_BIND_IP=127.0.0.1

# Grafana's admin password. No default anywhere in the compose file -- it
# refuses to start without this, the same rule the platform has applied since
# P3.1. Generate one: openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=

# --- Database credentials for the three exporters -------------------------
#
# Read-only monitoring access is enough. These do not need to be the
# application's own superuser accounts, and on a production deployment they
# should not be:
#
#   CREATE USER metrics WITH PASSWORD '...';
#   GRANT pg_monitor TO metrics;
#
# pg_monitor is what lets the exporter read pg_stat_archiver, which is the
# metric this whole stack most needs (see postgres-exporter/queries.yaml).
#
# Match the service names in each project's compose file, not host ports: the
# exporters reach each database over that project's own Docker network.

# atrocore-docker's PostgreSQL (service `db`).
ATROCORE_PG_USER=postgres
ATROCORE_PG_PASSWORD=
ATROCORE_PG_DB=postgres

# compliance_cmis's PostgreSQL (service `postgres`).
ALFRESCO_PG_USER=alfresco
ALFRESCO_PG_PASSWORD=
ALFRESCO_PG_DB=alfresco

# compliance_web's PostgreSQL (service `db`).
WEB_PG_USER=compliance
WEB_PG_PASSWORD=
WEB_PG_DB=compliance
